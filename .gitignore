# Root-anchored on purpose. These rules come from the standard Python template
# and are written unanchored, so a bare `lib/` also matched frontend/src/lib —
# which holds real modules (basemaps.ts, metrics.ts) that every view imports.
# Unanchored, they were silently excluded from the repository and the frontend
# would not build from a clean clone.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
htmlcov/
.coverage
.tox/

# Caches
backend/cache/
.cache/
*.cache

# Jupyter Notebook
.ipynb_checkpoints

