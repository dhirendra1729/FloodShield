Thumbs.db

# GIS Data (large files)
backend/data/raw/
backend/data/processed/
*.gpkg
*.shp
*.shx
*.dbf
*.prj

# Ignore massive TIFFs and GeoJSONs globally...
*.tif
*.geojson

# ...but ALLOW essential project datasets:
!frontend/public/data/
!frontend/public/data/*.tif
!frontend/public/data/*.geojson
!frontend/public/data/*.png
!backend/data/dam.geojson

# ANUGA simulation output.
# A .sww is the solver's raw result for one run and is regenerated by
# re-running the scenario. One such file reached 544 MB and, once tracked,
# made every git status/commit hash and delta it -- which is what pushed the
# editor's language server into the OOM killer. Never commit these.
*.sww
backend/data/anuga_runs/

# TypeScript incremental build info (regenerated by tsc)
*.tsbuildinfo

# Node dependencies and build output
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
